{
  "name": "portfolio",
  "version": "1.2.0",
  "description": "Personal developer portfolio built with Next.js, Tailwind CSS, and Framer Motion.",
  "homepage": "https://github.com/henchoznoe/Portfolio",
  "bugs": {
    "url": "https://github.com/henchoznoe/Portfolio/issues",
    "email": "henchoznoe@gmail.com"
  },
  "license": "MIT",
  "author": "Noé Henchoz <henchoznoe@gmail.com> (https://henchoznoe.ch/)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henchoznoe/Portfolio.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check --write .",
    "check:all": "biome check --write . && knip",
    "check:com": "biome check --write . && knip && tsc --noEmit && next build",
    "knip": "knip"
  },
  "lint-staged": {
    "*.{ts,tsx,css}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "private": true
}
